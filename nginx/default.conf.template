# OMECOnnect nginx site. Rendered at container start: ${SUPABASE_URL} is replaced
# with the environment variable of the same name. Other $variables are nginx's own.

# Keep admin pages out of search engines.
map $uri $omeconnect_robots_tag {
    ~^/admin-dashboard/  "noindex, nofollow";
    default              "";
}

server {
    listen 8080 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    charset utf-8;
    # Folder redirects (e.g. /admin-dashboard -> /admin-dashboard/) keep whatever
    # host and port the browser used, even if you map a port other than 8080.
    absolute_redirect off;

    # Security headers (same policy as the Netlify build): only this site's own
    # scripts may run, and the pages may only talk to the Supabase project.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ${SUPABASE_URL}; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag $omeconnect_robots_tag always;

    # Always check for a newer version of the app files after a rebuild.
    location ~* \.(?:html|js|css)$ {
        expires -1;
        try_files $uri =404;
    }

    # Health check used by Docker.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Installable-app description.
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        expires -1;
    }

    # Android app-link proof (must be public).
    location ^~ /.well-known/ {
        default_type application/json;
        try_files $uri =404;
    }

    # The Android app file: always download, never cache an old version.
    location ^~ /downloads/ {
        types { application/vnd.android.package-archive apk; }
        add_header Content-Disposition 'attachment; filename="OMECOnnect.apk"' always;
        add_header X-Content-Type-Options "nosniff" always;
        expires -1;
        try_files $uri =404;
    }

    # Never serve hidden files such as .env or .git.
    location ~ /\. {
        deny all;
        return 404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
