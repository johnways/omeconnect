{
  "id": "/admin-dashboard/",
  "name": "OMECO Staff Console",
  "short_name": "OMECO Staff",
  "description": "OMECOnnect staff console for OMECO employees (computers only).",
  "start_url": "/admin-dashboard/index.html?source=app",
  "scope": "/admin-dashboard/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "landscape",
  "background_color": "#0b2e6b",
  "theme_color": "#0b2e6b",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "staff-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "staff-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "staff-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
