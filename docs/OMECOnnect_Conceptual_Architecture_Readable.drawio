<mxfile host="app.diagrams.net" agent="OMECOnnect generator" version="24.0.0"><diagram id="concept-large" name="Conceptual Architecture"><mxGraphModel dx="1690" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1690" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='&lt;b style="font-size:26px"&gt;OMECOnnect – Conceptual Architecture&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:15px;color:#444444"&gt;Occidental Mindoro Electric Cooperative (OMECO): who uses the system, the apps they use, the Supabase cloud backend, and the outside services it relies on.&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1630" height="70" as="geometry"/></mxCell><mxCell id="L1-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fbfbfb;strokeColor=#5b6b7f;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="210" height="775" as="geometry"/></mxCell><mxCell id="L1-hd" value="&lt;b&gt;USERS&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#ffffff;fillColor=#5b6b7f;rounded=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="116" width="210" height="30" as="geometry"/></mxCell><mxCell id="L2-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fbfbfb;strokeColor=#4a74b4;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="340" height="775" as="geometry"/></mxCell><mxCell id="L2-hd" value="&lt;b&gt;PRESENTATION LAYER&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#ffffff;fillColor=#4a74b4;rounded=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="250" y="116" width="340" height="30" as="geometry"/></mxCell><mxCell id="L3-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fbfbfb;strokeColor=#3d8b3d;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="660" y="150" width="580" height="775" as="geometry"/></mxCell><mxCell id="L3-hd" value="&lt;b&gt;BACKEND – SUPABASE CLOUD&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#ffffff;fillColor=#3d8b3d;rounded=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="660" y="116" width="580" height="30" as="geometry"/></mxCell><mxCell id="L4-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fbfbfb;strokeColor=#c07a00;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1330" y="150" width="330" height="775" as="geometry"/></mxCell><mxCell id="L4-hd" value="&lt;b&gt;EXTERNAL SERVICES&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#ffffff;fillColor=#c07a00;rounded=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1330" y="116" width="330" height="30" as="geometry"/></mxCell><mxCell id="cust" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeWidth=2;fillColor=#dae8fc;strokeColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="95" y="240" width="60" height="100" as="geometry"/></mxCell><mxCell id="cust-t" value='&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Residential · Commercial&lt;br&gt;Industrial · Public&lt;/span&gt;' style="text;html=1;align=center;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="190" height="70" as="geometry"/></mxCell><mxCell id="staff" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeWidth=2;fillColor=#dae8fc;strokeColor=#333333;fontSize=16;" vertex="1" parent="1"><mxGeometry x="95" y="530" width="60" height="100" as="geometry"/></mxCell><mxCell id="staff-t" value='&lt;b&gt;OMECO Staff&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Admin · Supervisor · Billing&lt;br&gt;Service · Engineering&lt;/span&gt;' style="text;html=1;align=center;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="635" width="190" height="70" as="geometry"/></mxCell><mxCell id="app" value='&lt;b style="font-size:17px"&gt;Customer Mobile App&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13px;color:#444444"&gt;Web app (PWA) + Android APK&lt;/i&gt;&lt;div style="margin-top:6px"&gt;• Bills &amp;amp; Statement of Account&lt;br&gt;• Bill estimator (kWh → ₱)&lt;br&gt;• Power status · report outage&lt;br&gt;• Concerns with photos &amp;amp; rating&lt;br&gt;• Alerts · English / Filipino&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="270" y="180" width="300" height="250" as="geometry"/></mxCell><mxCell id="admin" value='&lt;b style="font-size:17px"&gt;Admin Dashboard&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13px;color:#444444"&gt;Private staff site · 2-step verification&lt;/i&gt;&lt;div style="margin-top:6px"&gt;• Customer verification&lt;br&gt;• Bills, rates &amp;amp; CSV import&lt;br&gt;• Concerns, target times, outages&lt;br&gt;• Meter readings &amp;amp; reports&lt;br&gt;• Staff roles · audit log · backups&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="270" y="470" width="300" height="250" as="geometry"/></mxCell><mxCell id="host" value='&lt;b style="font-size:17px"&gt;Vercel Hosting&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13px;color:#444444"&gt;Serves both apps&lt;/i&gt;&lt;div style="margin-top:6px"&gt;• Public customer site&lt;br&gt;• Private staff site (not indexed)&lt;br&gt;• Service worker: push &amp;amp; updates&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="270" y="765" width="300" height="130" as="geometry"/></mxCell><mxCell id="access" value='&lt;b style="font-size:17px"&gt;Supabase Access Layer&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#eef7ec;strokeColor=#82b366;strokeWidth=2;fontSize=14;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="680" y="180" width="250" height="520" as="geometry"/></mxCell><mxCell id="api" value='&lt;b style="font-size:17px"&gt;Data API&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13px;color:#444444"&gt;REST / RPC (PostgREST)&lt;/i&gt;&lt;div style="margin-top:6px"&gt;• HTTPS + JWT token&lt;br&gt;• Business rules in SQL&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="695" y="220" width="220" height="150" as="geometry"/></mxCell><mxCell id="rt" value='&lt;b style="font-size:17px"&gt;Realtime&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13px;color:#444444"&gt;WebSocket&lt;/i&gt;&lt;div style="margin-top:6px"&gt;• Live updates on&lt;br&gt;• open screens&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d9f2ef;strokeColor=#3e9c8f;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="695" y="385" width="220" height="130" as="geometry"/></mxCell><mxCell id="store" value='&lt;b style="font-size:17px"&gt;Storage (private)&lt;/b&gt;&lt;div style="margin-top:6px"&gt;• Profile photos&lt;br&gt;• Concern &amp;amp; meter photos&lt;br&gt;• Backup files&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="695" y="530" width="220" height="150" as="geometry"/></mxCell><mxCell id="db" value='&lt;b style="font-size:17px"&gt;PostgreSQL Database&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13px;color:#444444"&gt;Row Level Security&lt;/i&gt;&lt;div style="margin-top:6px"&gt;• Users &amp;amp; accounts&lt;br&gt;• Bills, rates, payments&lt;br&gt;• Concerns, announcements&lt;br&gt;• Readings, notifications, logs&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="680" y="745" width="250" height="160" as="geometry"/></mxCell><mxCell id="auth" value='&lt;b style="font-size:17px"&gt;Supabase Auth&lt;/b&gt;&lt;div style="margin-top:6px"&gt;• Email + password&lt;br&gt;• Google sign-in&lt;br&gt;• SMS one-time code&lt;br&gt;• Authenticator 2FA (staff)&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="980" y="180" width="240" height="160" as="geometry"/></mxCell><mxCell id="fn" value='&lt;b style="font-size:17px"&gt;Edge Functions&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13px;color:#444444"&gt;Server code (Deno)&lt;/i&gt;&lt;div style="margin-top:6px"&gt;• send-push&lt;br&gt;• send-sms-textbee&lt;br&gt;• create-payment&lt;br&gt;• paymongo-webhook&lt;br&gt;• ai-assistant&lt;br&gt;• nightly-backup&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="980" y="360" width="240" height="340" as="geometry"/></mxCell><mxCell id="cron" value='&lt;b style="font-size:17px"&gt;Scheduled Jobs&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13px;color:#444444"&gt;pg_cron&lt;/i&gt;&lt;div style="margin-top:6px"&gt;• 8 AM bill&lt;br&gt;• reminders&lt;br&gt;• 2 AM backup&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="980" y="745" width="115" height="160" as="geometry"/></mxCell><mxCell id="vault" value='&lt;b style="font-size:17px"&gt;Vault&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13px;color:#444444"&gt;secrets&lt;/i&gt;&lt;div style="margin-top:6px"&gt;• Push keys&lt;br&gt;• API keys&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1105" y="745" width="115" height="160" as="geometry"/></mxCell><mxCell id="google" value='&lt;b style="font-size:17px"&gt;Google Sign-In&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13px;color:#444444"&gt;OAuth 2.0&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1350" y="180" width="290" height="70" as="geometry"/></mxCell><mxCell id="mail" value='&lt;b style="font-size:17px"&gt;Email Service&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:13px;color:#444444"&gt;Supabase mailer · Brevo SMTP&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1350" y="265" width="290" height="70" as="geometry"/></mxCell><mxCell id