ed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="dfd-18" target="dfd-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dfd-42" value="bills, payments" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="dfd-23" target="dfd-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dfd-43" value="bills &amp; due dates" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.2;entryX=0.35;entryY=1;" edge="1" parent="1" source="dfd-23" target="dfd-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dfd-44" value="announcement" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.9;exitY=0;entryX=0.25;entryY=0.9;" edge="1" parent="1" source="dfd-18" target="dfd-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dfd-45" value="published notice" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="dfd-24" target="dfd-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dfd-46" value="alerts by area" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="dfd-24" target="dfd-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dfd-47" value="alerts" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.25;entryX=1;entryY=0.5;" edge="1" parent="1" source="dfd-24" target="dfd-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dfd-48" value="concern" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="dfd-17" target="dfd-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dfd-49" value="complaint + status" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dfd-25" target="dfd-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dfd-50" value="status update" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0.2;entryY=0.85;" edge="1" parent="1" source="dfd-18" target="dfd-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dfd-51" value="question" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0.1;entryY=0.2;" edge="1" parent="1" source="dfd-17" target="dfd-26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dfd-52" value="chat log" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dfd-26" target="dfd-33"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="seq1" name="4. Sequence – Sign-up with SMS OTP"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seq1-1" value="&lt;b style='font-size:20px'&gt;Sequence Diagram – Customer Sign-up with Mobile OTP (highlight feature)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;The account is only created after the 6-digit SMS code is verified. Codes expire after 5 minutes.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="50" as="geometry"/></mxCell><mxCell id="seq1-2" value="Customer" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=52;outlineConnect=0;size=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100.0" y="80" width="40" height="746" as="geometry"/></mxCell><mxCell id="seq1-3" value="Mobile App" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="160" height="746" as="geometry"/></mxCell><mxCell id="seq1-4" value="Supabase Auth" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="80" width="160" height="746" as="geometry"/></mxCell><mxCell id="seq1-5" value="Edge Function&lt;br&gt;send-sms-textbee" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670" y="80" width="160" height="746" as="geometry"/></mxCell><mxCell id="seq1-6" value="textbee +&lt;br&gt;Android SIM" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="80" width="160" height="746" as="geometry"/></mxCell><mxCell id="seq1-7" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1090" y="80" width="160" height="746" as="geometry"/></mxCell><mxCell id="seq1-8" value="1. Fill form (name, email, mobile, account no., password) → Continue" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="170" as="sourcePoint"/><mxPoint x="330.0" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-9" value="2. POST /otp (phone, create_user)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="214" as="sourcePoint"/><mxPoint x="540.0" y="214" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-10" value="3. Send SMS hook (phone, 6-digit code), signed" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540.0" y="258" as="sourcePoint"/><mxPoint x="750.0" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-11" value="4. send-sms (recipient, message)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="302" as="sourcePoint"/><mxPoint x="960.0" y="302" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-12" value="5. SMS: “OMECOnnect code: ••••••, valid 5 min”" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960.0" y="346" as="sourcePoint"/><mxPoint x="120.0" y="346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-13" value="6. Show code screen + 5:00 countdown" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="390" as="sourcePoint"/><mxPoint x="120.0" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-14" value="7. Enter 6-digit code → Verify" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="434" as="sourcePoint"/><mxPoint x="330.0" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-15" value="8. POST /verify (phone, code)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="478" as="sourcePoint"/><mxPoint x="540.0" y="478" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-16" value="9. Create account → trigger creates profile" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540.0" y="522" as="sourcePoint"/><mxPoint x="1170.0" y="522" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-17" value="10. Session (phone verified)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540.0" y="566" as="sourcePoint"/><mxPoint x="330.0" y="566" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-18" value="11. PUT /user (email, password)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="610" as="sourcePoint"/><mxPoint x="540.0" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-19" value="12. Email confirmation link" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540.0" y="654" as="sourcePoint"/><mxPoint x="120.0" y="654" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-20" value="13. Insert verification request (RLS: verified phone only)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="698" as="sourcePoint"/><mxPoint x="1170.0" y="698" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-21" value="14. “Account created. Confirm your email, then sign in.”" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="742" as="sourcePoint"/><mxPoint x="120.0" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-22" value="&lt;b&gt;alt [code older than 5 minutes]&lt;/b&gt;: the app locks the code field and the server rejects the code → customer taps &lt;b&gt;Resend code&lt;/b&gt; (allowed every 60 s) → a new code with a new 5 minutes." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="846" width="1210" height="60" as="geometry"/></mxCell><mxCell id="seq1-23" value="&lt;b&gt;alt [number already has an account]&lt;/b&gt;: the app refuses, signs out, and asks the customer to sign in instead (no overwrite)." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="916" width="1210" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="seq2" name="5. Sequence – Sign-in &amp; Security Checks"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seq2-1" value="&lt;b style='font-size:20px'&gt;Sequence Diagram – Sign-in with Google and Security Checks&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;After any sign-in the app checks: admin? verified mobile? 2-step on? Then it loads only this customer's data.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="50" as="geometry"/></mxCell><mxCell id="seq2-2" value="Customer" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=52;outlineConnect=0;size=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100.0" y="80" width="40" height="834" as="geometry"/></mxCell><mxCell id="seq2-3" value="Mobile App" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="160" height="834" as="geometry"/></mxCell><mxCell id="seq2-4" value="Google" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="80" width="160" height="834" as="geometry"/></mxCell><mxCell id="seq2-5" value="Supabase Auth" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670" y="80" width="160" height="834" as="geometry"/></mxCell><mxCell id="seq2-6" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="80" width="160" height="834" as="geometry"/></mxCell><mxCell id="seq2-7" value="1. Tap “Continue with Google”" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="170" as="sourcePoint"/><mxPoint x="330.0" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-8" value="2. /authorize (provider=google, PKCE challenge)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="214" as="sourcePoint"/><mxPoint x="750.0" y="214" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-9" value="3. Redirect to Google sign-in" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="258" as="sourcePoint"/><mxPoint x="540.0" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-10" value="4. Choose account / allow" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="302" as="sourcePoint"/><mxPoint x="540.0" y="302" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-11" value="5. Authorization code (callback)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540.0" y="346" as="sourcePoint"/><mxPoint x="750.0" y="346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-12" value="6. Redirect back with ?code=" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="390" as="sourcePoint"/><mxPoint x="330.0" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-13" value="7. /token (code + PKCE verifier)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="434" as="sourcePoint"/><mxPoint x="750.0" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-14" value="8. Session (aal1)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="478" as="sourcePoint"/><mxPoint x="330.0" y="478" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-15" value="9. rpc is_omeco_admin() → admins use the dashboard" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="522" as="sourcePoint"/><mxPoint x="960.0" y="522" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-16" value="10. GET /user (phone status, 2-step factors)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="566" as="sourcePoint"/><mxPoint x="750.0" y="566" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-17" value="11. [no verified mobile] → Verify-mobile OTP step (5-min code)" style="shape=note;whiteSpace=wrap;html=1;size=10;fontSize=10;align=left;spacingLeft=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="338.0" y="594" width="300" height="32" as="geometry"/></mxCell><mxCell id="seq2-18" value="12. [2-step on] challenge + verify authenticator code" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="654" as="sourcePoint"/><mxPoint x="750.0" y="654" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-19" value="13. Upgraded session (aal2)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="698" as="sourcePoint"/><mxPoint x="330.0" y="698" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-20" value="14. Load profile, account, bills, announcements, notifications" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="742" as="sourcePoint"/><mxPoint x="960.0" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-21" value="15. Only this customer's rows (RLS + 2-step rule)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960.0" y="786" as="sourcePoint"/><mxPoint x="330.0" y="786" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-22" value="16. Show dashboard" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="830" as="sourcePoint"/><mxPoint x="120.0" y="830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-23" value="Email + password sign-in follows the same path from step 8 (POST /token grant_type=password)." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="934" width="1000" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="seq3" name="6. Sequence – Announcement to Notification"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seq3-1" value="&lt;b style='font-size:20px'&gt;Sequence Diagram – Publishing an Announcement → Customer Alert&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Notifications are created automatically by the database for verified customers in the affected service area.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="50" as="geometry"/></mxCell><mxCell id="seq3-2" value="OMECO Staff" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=52;outlineConnect=0;size=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100.0" y="80" width="40" height="570" as="geometry"/></mxCell><mxCell id="seq3-3" value="Admin Dashboard" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="160" height="570" as="geometry"/></mxCell><mxCell id="seq3-4" value="Data API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="80" width="160" height="570" as="geometry"/></mxCell><mxCell id="seq3-5" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670" y="80" width="160" height="570" as="geometry"/></mxCell><mxCell id="seq3-6" value="Customer App" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="80" width="160" height="570" as="geometry"/></mxCell><mxCell id="seq3-7" value="Customer" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=52;outlineConnect=0;size=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150.0" y="80" width="40" height="570" as="geometry"/></mxCell><mxCell id="seq3-8" value="1. Write announcement (title, affected area) → Publish" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="170" as="sourcePoint"/><mxPoint x="330.0" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-9" value="2. Insert announcement (is_published = true) + staff JWT" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="214" as="sourcePoint"/><mxPoint x="540.0" y="214" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-10" value="3. RLS check: is_omeco_admin()" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540.0" y="258" as="sourcePoint"/><mxPoint x="750.0" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-11" value="4. Trigger notify_customers_of_announcement → insert notifications for verified customers in area" style="shape=note;whiteSpace=wrap;html=1;size=10;fontSize=10;align=left;spacingLeft=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="758.0" y="286" width="300" height="32" as="geometry"/></mxCell><mxCell id="seq3-12" value="5. Saved" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540.0" y="346" as="sourcePoint"/><mxPoint x="330.0" y="346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-13" value="6. Open app" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170.0" y="390" as="sourcePoint"/><mxPoint x="960.0" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-14" value="7. GET notifications + announcements (customer JWT)" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960.0" y="434" as="sourcePoint"/><mxPoint x="540.0" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-15" value="8. RLS: own notifications, published notices for own area" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540.0" y="478" as="sourcePoint"/><mxPoint x="750.0" y="478" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-16" value="9. New alert" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="522" as="sourcePoint"/><mxPoint x="960.0" y="522" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-17" value="10. Show alert card on dashboard" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960.0" y="566" as="sourcePoint"/><mxPoint x="1170.0" y="566" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-18" value="Same path for bills: a new bill row triggers a “New electricity bill” notification; a daily pg_cron job (queue_due_bill_notifications) adds “Bill due soon” reminders. Push to phones via FCM is planned." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1210" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="usecase" name="7. Use Case Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="usecase-1" value="&lt;b style='font-size:20px'&gt;OMECOnnect – Use Case Diagram&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;What each end-user can access. «include» = always part of it; «extend» = only in some cases.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="50" as="geometry"/></mxCell><mxCell id="usecase-2" value="&lt;b&gt;OMECOnnect System&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#333333;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="230" y="70" width="900" height="960" as="geometry"/></mxCell><mxCell id="usecase-3" value="Customer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="40" height="80" as="geometry"/></mxCell><mxCell id="usecase-4" value="OMECO Staff / Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1230" y="440" width="40" height="80" as="geometry"/></mxCell><mxCell id="usecase-5" value="Google&lt;br&gt;(secondary)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="1230" y="210" width="40" height="80" as="geometry"/></mxCell><mxCell id="usecase-6" value="SMS Gateway&lt;br&gt;(secondary)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="1230" y="70" width="40" height="80" as="geometry"/></mxCell><mxCell id="usecase-7" value="Register account" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="210" height="60" as="geometry"/></mxCell><mxCell id="usecase-8" value="" style="endArrow=none