<mxfile host="app.diagrams.net" agent="OMECOnnect generator" version="24.0.0"><diagram id="concept" name="1. Conceptual Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="concept-1" value="&lt;b style='font-size:20px'&gt;OMECOnnect – Conceptual Architecture&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Who uses the system, the apps they use, the Supabase cloud backend, and the outside services it relies on.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="50" as="geometry"/></mxCell><mxCell id="concept-2" value="&lt;b&gt;OMECOnnect Cloud Backend (Supabase)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=bottom;align=right;spacingRight=12;spacingBottom=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="495" y="100" width="720" height="680" as="geometry"/></mxCell><mxCell id="concept-3" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Residential · Commercial · Industrial&lt;/span&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="175" width="40" height="70" as="geometry"/></mxCell><mxCell id="concept-4" value="&lt;b&gt;OMECO Staff&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Supervisor · Billing · Service · Engineering&lt;/span&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="485" width="40" height="70" as="geometry"/></mxCell><mxCell id="concept-5" value="&lt;b&gt;Customer App&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;web + installable Android app (PWA / APK)&lt;/i&gt;&lt;br&gt;Bills, statement &amp;amp; barcode&lt;br&gt;Bill estimator (meter → kWh → ₱)&lt;br&gt;Power status · report no power&lt;br&gt;Concerns · alerts · profile &amp;amp; privacy&lt;br&gt;English / Filipino · light / dark" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="130" width="250" height="215" as="geometry"/></mxCell><mxCell id="concept-6" value="&lt;b&gt;Staff Console&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;private site · 2-step verification required&lt;/i&gt;&lt;br&gt;Verification · bills &amp;amp; rates · CSV import&lt;br&gt;Concerns, target times, outages by area&lt;br&gt;Meter readings · reports&lt;br&gt;Staff roles · audit log · backups" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="440" width="250" height="215" as="geometry"/></mxCell><mxCell id="concept-7" value="&lt;b&gt;Hosting: Vercel&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;public customer site + private staff site&lt;/i&gt;&lt;br&gt;Docker image for local runs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#8a8a8a;" vertex="1" parent="1"><mxGeometry x="200" y="700" width="250" height="76" as="geometry"/></mxCell><mxCell id="concept-8" value="&lt;b&gt;Data API (PostgREST)&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;REST + RPC over HTTPS&lt;/i&gt;&lt;br&gt;sign-in token (JWT)&lt;br&gt;on every request" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="525" y="150" width="190" height="115" as="geometry"/></mxCell><mxCell id="concept-9" value="&lt;b&gt;Realtime&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;WebSocket&lt;/i&gt;&lt;br&gt;live updates on&lt;br&gt;open screens" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d9f2ef;strokeColor=#3e9c8f;" vertex="1" parent="1"><mxGeometry x="525" y="300" width="190" height="100" as="geometry"/></mxCell><mxCell id="concept-10" value="&lt;b&gt;Storage (private)&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;own-folder access only&lt;/i&gt;&lt;br&gt;profile, concern &amp;amp;&lt;br&gt;meter photos · backups" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="525" y="440" width="190" height="115" as="geometry"/></mxCell><mxCell id="concept-11" value="&lt;b&gt;PostgreSQL Database&lt;/b&gt;&lt;br&gt;users · accounts (R / C / I / P)&lt;br&gt;bills · rates · statements&lt;br&gt;announcements · complaints&lt;br&gt;meter readings · payments&lt;br&gt;notifications · audit logs&lt;br&gt;&lt;br&gt;Row Level Security +&lt;br&gt;staff roles on every table" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="775" y="150" width="200" height="300" as="geometry"/></mxCell><mxCell id="concept-12" value="&lt;b&gt;Scheduled jobs (pg_cron)&lt;/b&gt;&lt;br&gt;8:00 AM bill reminders&lt;br&gt;2:00 AM nightly backup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="775" y="490" width="200" height="90" as="geometry"/></mxCell><mxCell id="concept-13" value="&lt;b&gt;Vault&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;encrypted secrets&lt;/i&gt;&lt;br&gt;push keys · hook secrets" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#8a8a8a;" vertex="1" parent="1"><mxGeometry x="775" y="620" width="200" height="80" as="geometry"/></mxCell><mxCell id="concept-14" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;email + password&lt;br&gt;Google (OAuth PKCE)&lt;br&gt;SMS one-time code&lt;br&gt;authenticator 2-step" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1035" y="150" width="160" height="140" as="geometry"/></mxCell><mxCell id="concept-15" value="&lt;b&gt;Edge Functions&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;server code (Deno)&lt;/i&gt;&lt;br&gt;send-push&lt;br&gt;send-sms-textbee&lt;br&gt;nightly-backup&lt;br&gt;create-payment&lt;br&gt;paymongo-webhook&lt;br&gt;ai-assistant" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1035" y="330" width="160" height="250" as="geometry"/></mxCell><mxCell id="concept-16" value="&lt;b&gt;Google Sign-In&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;OAuth 2.0&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1250" y="150" width="270" height="55" as="geometry"/></mxCell><mxCell id="concept-17" value="&lt;b&gt;Email service&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;Supabase mailer · Brevo SMTP (add key)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1250" y="225" width="270" height="55" as="geometry"/></mxCell><mxCell id="concept-18" value="&lt;b&gt;textbee SMS gateway&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;Android phone + PH SIM → customer&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1250" y="340" width="270" height="55" as="geometry"/></mxCell><mxCell id="concept-19" value="&lt;b&gt;Web Push service&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555'&gt;pop-