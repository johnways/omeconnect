rced in the database, not only in the app.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="50" as="geometry"/></mxCell><mxCell id="layer-2" value="&lt;b&gt;Presentation Layer&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=45;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1300" height="150" as="geometry"/></mxCell><mxCell id="layer-3" value="&lt;b&gt;Customer Mobile App&lt;/b&gt;&lt;br&gt;Login · Register + SMS OTP · Dashboard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="240" height="95" as="geometry"/></mxCell><mxCell id="layer-4" value="Bills · Consumption · Announcements" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="120" width="240" height="95" as="geometry"/></mxCell><mxCell id="layer-5" value="Concerns · AI Assistant" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="240" height="95" as="geometry"/></mxCell><mxCell id="layer-6" value="Profile · Link account · 2-step setup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="825" y="120" width="240" height="95" as="geometry"/></mxCell><mxCell id="layer-7" value="&lt;b&gt;Admin Dashboard&lt;/b&gt;&lt;br&gt;Verification · Billing · Announcements · Complaints" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="240" height="95" as="geometry"/></mxCell><mxCell id="layer-8" value="&lt;b&gt;Application / Service Layer&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;opacity=45;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="1300" height="150" as="geometry"/></mxCell><mxCell id="layer-9" value="&lt;b&gt;Client modules&lt;/b&gt;&lt;br&gt;supabase-client.js · script.js" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="295" width="240" height="95" as="geometry"/></mxCell><mxCell id="layer-10" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;email/password · Google OAuth (PKCE)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="295" width="240" height="95" as="geometry"/></mxCell><mxCell id="layer-11" value="&lt;b&gt;Phone OTP&lt;/b&gt;&lt;br&gt;6 digits · 5-min expiry · resend 60 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="295" width="240" height="95" as="geometry"/></mxCell><mxCell id="layer-12" value="&lt;b&gt;2-step (TOTP)&lt;/b&gt;&lt;br&gt;authenticator app · aal2 session" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="825" y="295" width="240" height="95" as="geometry"/></mxCell><mxCell id="layer-13" value="&lt;b&gt;Data API (PostgREST)&lt;/b&gt; + Edge Function send-sms-textbee" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="295" width="240" height="95" as="geometry"/></mxCell><mxCell id="layer-14" value="" style="endArrow=block;endFill=1;html=1;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geo